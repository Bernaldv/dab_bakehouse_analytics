{
  "datasets": [
    {
      "name": "transactions_summary_metrics",
      "displayName": "Resumen de Transacciones",
      "config": {
        "version": "1.1",
        "source": "bakehouse_analytics_dev.rnd.transactions_summary",
        "dimensions": [
          {
            "name": "product",
            "expr": "product",
            "displayName": "Producto"
          },
          {
            "name": "payment_method",
            "expr": "paymentMethod",
            "displayName": "Método de pago"
          }
        ],
        "measures": [
          {
            "name": "total_sales",
            "expr": "SUM(total_price)",
            "displayName": "Ventas totales",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_units",
            "expr": "SUM(total_quantity)",
            "displayName": "Unidades totales",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "fc46357f",
      "displayName": "Untitled page",
      "layout": [
        {
          "widget": {
            "name": "resumen_texto",
            "multilineTextboxSpec": {
              "lines": [
                "## Ventas por producto y método de pago"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "ventas_totales_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "transactions_summary_metrics",
                  "fields": [
                    {
                      "name": "measure(total_sales)",
                      "expression": "MEASURE(`total_sales`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Ventas Totales"
              },
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(total_sales)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 4,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "participacion_metodo_pago",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "transactions_summary_metrics",
                  "fields": [
                    {
                      "name": "measure(total_sales)",
                      "expression": "MEASURE(`total_sales`)"
                    },
                    {
                      "name": "payment_method",
                      "expression": "`payment_method`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Participación por Método de Pago"
              },
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "measure(total_sales)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "total_sales"
                },
                "color": {
                  "fieldName": "payment_method",
                  "displayName": "payment_method",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 2,
            "width": 8,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "ventas_por_producto",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "transactions_summary_metrics",
                  "fields": [
                    {
                      "name": "product",
                      "expression": "`product`"
                    },
                    {
                      "name": "measure(total_sales)",
                      "expression": "MEASURE(`total_sales`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Ventas Totales por Producto"
              },
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "product",
                  "displayName": "product",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "measure(total_sales)",
                  "displayName": "total_sales",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "product",
                  "displayName": "product",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 8,
            "width": 12,
            "height": 6
          }
        },
        {
          "widget": {
            "name": "detalle_producto_pago",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "transactions_summary_metrics",
                  "fields": [
                    {
                      "name": "product",
                      "expression": "`product`"
                    },
                    {
                      "name": "payment_method",
                      "expression": "`payment_method`"
                    },
                    {
                      "name": "measure(total_units)",
                      "expression": "MEASURE(`total_units`)"
                    },
                    {
                      "name": "measure(total_sales)",
                      "expression": "MEASURE(`total_sales`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": "Detalle por Producto y Método de Pago"
              },
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "product"
                  },
                  {
                    "fieldName": "payment_method"
                  },
                  {
                    "fieldName": "measure(total_units)"
                  },
                  {
                    "fieldName": "measure(total_sales)"
                  }
                ]
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 14,
            "width": 12,
            "height": 6
          }
        }
      ],
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1"
    }
  ],
  "uiSettings": {
    "theme": {
      "widgetHeaderAlignment": "ALIGNMENT_UNSPECIFIED"
    },
    "applyModeEnabled": false
  }
}
